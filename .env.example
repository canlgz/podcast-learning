# Google AI Studio 金鑰：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 章節地圖與互動腳本用的模型
GEMINI_MODEL=gemini-3.8-flash

# 逐字稿用的模型（需支援音訊＋JSON 輸出；留空則沿用 GEMINI_MODEL）
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

# 網頁對話用的模型（要反應快，用 flash 比較好）
GEMINI_CHAT_MODEL=gemini-3.8-flash

# 音檔來源資料夾（放多少集就掃多少集，支援兩層子資料夾）
PODCAST_SOURCE_DIR=/Users/你的帳號/Downloads/podcast

# --watch 模式的掃描間隔（毫秒）
PODCAST_WATCH_INTERVAL_MS=120000

# 費用估算單價覆寫（USD / 1M tokens），只有在 Google 調價時才需要動
# GEMINI_PRICE_IN_AUDIO=0.75
# GEMINI_PRICE_IN_TEXT=0.75
# GEMINI_PRICE_OUT=3.75
